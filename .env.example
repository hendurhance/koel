# =============================================================================
# Koel — environment configuration
# Copy to `.env` and fill in. Every knob the app honours lives here.
# =============================================================================

# ----- Core ------------------------------------------------------------------
APP_ENV=development                   # development | production
APP_SECRET=please-change-me-to-32-plus-random-chars
LOG_LEVEL=INFO

# Public port the API binds on (docker compose host mapping)
APP_PORT=8000

# Public port the dashboard binds on (docker compose host mapping)
FRONTEND_PORT=3000

# ----- Database --------------------------------------------------------------
# SQLAlchemy 2.0 + psycopg 3 URL.
# Docker: host=postgres. Local dev without Docker: host=localhost.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/koel

# Connection pool, per process. Each API/Celery process opens its own pool, so
# keep  processes * (DB_POOL_SIZE + DB_MAX_OVERFLOW) <= postgres max_connections
# (default 100). For real multi-worker scale, front Postgres with PgBouncer.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# ----- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----- Celery ----------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ----- Scraping --------------------------------------------------------------
# Tier → default interval (seconds). Per-currency override available in DB.
SCRAPE_INTERVAL_MAJOR=300             # 5 min  — USD, EUR, GBP, JPY, ...
SCRAPE_INTERVAL_STANDARD=3600         # 1 h    — most fiat
SCRAPE_INTERVAL_EXOTIC=21600          # 6 h    — low-liquidity
SCRAPE_DELTA_THRESHOLD_BPS=5          # 5 bps = 0.05 %  — history write gate
SCRAPE_ANCHOR_INTERVAL_SECONDS=3600   # force a history write at most this often

# Optional HTTP proxy. Leave empty to go direct.
PROXY_URL=

# ----- Auth ------------------------------------------------------------------
# SMTP (bring your own). Works with Mailtrap, Mailjet, Postmark, Gmail, Postfix.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# Magic-link + Redis session lifetimes
MAGIC_LINK_TTL_SECONDS=900            # 15 min
SESSION_TTL_SECONDS=604800            # 7 days

# Where magic-link emails should land users. Point at the dashboard if you run
# one. Leave blank for API-only deployments — the link will go to APP_BASE_URL.
FRONTEND_BASE_URL=http://localhost:3000

# Bootstrap admin: on first sign-in, the user with this email is promoted.
# Leave blank once an admin exists.
INITIAL_ADMIN_EMAIL=

# ----- Notifications ---------------------------------------------------------
# Slack incoming webhook. Empty = feature off.
SLACK_WEBHOOK_URL=

# ----- Backups ---------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=koel/backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
